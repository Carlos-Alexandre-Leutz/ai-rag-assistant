# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# PostgreSQL with the pgvector extension.
# Local docker compose (service "db"):
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DATABASE
# Remote example (e.g. Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional tuning (defaults shown). Changing EMBEDDING_MODEL requires uploading
# every document again; it must output 768 dimensions.
# GENERATION_MODEL=models/gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MAX_DISTANCE=0.52   # empty value disables the filter
